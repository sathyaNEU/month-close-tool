{
  "_sample": "SAMPLE configuration for testing, not your company's accounting (docs/domain/sample-journal-rules.md)",
  "body": {
    "effective_from": "2026-06-01",
    "spec": {
      "amounts": [
        "card",
        "store_credit",
        "item_price",
        "buyer_fee",
        "shipping",
        "tax",
        "incentive",
        "seller_fee",
        "processing_fee"
      ],
      "attributes": [
        "stage",
        "psp"
      ],
      "description": "A buyer's order is captured: card and store credit taken, tax collected",
      "event_type": "ORDER_CAPTURED",
      "identities": [
        {
          "expr": {
            "args": [
              {
                "args": [
                  {
                    "col": "amount_card"
                  },
                  {
                    "col": "amount_store_credit"
                  }
                ],
                "fn": "add"
              },
              {
                "args": [
                  {
                    "args": [
                      {
                        "args": [
                          {
                            "args": [
                              {
                                "col": "amount_item_price"
                              },
                              {
                                "col": "amount_buyer_fee"
                              }
                            ],
                            "fn": "add"
                          },
                          {
                            "col": "amount_shipping"
                          }
                        ],
                        "fn": "add"
                      },
                      {
                        "col": "amount_tax"
                      }
                    ],
                    "fn": "add"
                  },
                  {
                    "col": "amount_incentive"
                  }
                ],
                "fn": "sub"
              }
            ],
            "fn": "eq"
          },
          "name": "payment"
        }
      ],
      "sources": [
        {
          "filter": null,
          "landing_table": "landing.orders",
          "lookups": [],
          "mapping": {
            "accounting_date": {
              "args": [
                {
                  "col": "placed_at"
                }
              ],
              "fn": "date_of"
            },
            "amount_buyer_fee": {
              "col": "buyer_fee_minor"
            },
            "amount_card": {
              "col": "card_amount_minor"
            },
            "amount_incentive": {
              "col": "incentive_minor"
            },
            "amount_item_price": {
              "col": "item_price_minor"
            },
            "amount_processing_fee": {
              "col": "seller_processing_fee_minor"
            },
            "amount_seller_fee": {
              "col": "seller_fee_minor"
            },
            "amount_shipping": {
              "col": "shipping_minor"
            },
            "amount_store_credit": {
              "col": "store_credit_minor"
            },
            "amount_tax": {
              "col": "tax_minor"
            },
            "attr_psp": {
              "col": "psp"
            },
            "attr_stage": {
              "lit": "payment",
              "type": "string"
            },
            "currency": {
              "col": "currency"
            },
            "entity_id": {
              "col": "entity_id"
            },
            "order_id": {
              "col": "order_id"
            },
            "program": {
              "col": "program"
            },
            "seller_id": {
              "col": "seller_id"
            }
          },
          "source_id": "orders"
        }
      ],
      "type_id": "sample_order_captured"
    }
  },
  "resource": "event-types"
}
