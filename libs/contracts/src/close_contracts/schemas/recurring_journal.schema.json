{
  "$defs": {
    "RecurringLine": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "pattern": "^[A-Za-z0-9._-]{1,32}$",
          "title": "Account",
          "type": "string"
        },
        "amount_minor": {
          "exclusiveMinimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "dimensions": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Dimensions",
          "type": "object"
        },
        "side": {
          "enum": [
            "DR",
            "CR"
          ],
          "title": "Side",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "account",
        "side",
        "amount_minor"
      ],
      "title": "RecurringLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Created in each due period: monthly, or quarterly in the first month of each quarter.",
  "properties": {
    "auto_approve": {
      "default": false,
      "title": "Auto Approve",
      "type": "boolean"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "day": {
      "maximum": 28,
      "minimum": 1,
      "title": "Day",
      "type": "integer"
    },
    "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "entity_id": {
      "pattern": "^[A-Z0-9]{2,16}$",
      "title": "Entity Id",
      "type": "string"
    },
    "first_period": {
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "title": "First Period",
      "type": "string"
    },
    "frequency": {
      "enum": [
        "monthly",
        "quarterly"
      ],
      "title": "Frequency",
      "type": "string"
    },
    "header": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Header",
      "type": "object"
    },
    "last_period": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Period"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/RecurringLine"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Lines",
      "type": "array"
    },
    "preparer": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Preparer",
      "type": "string"
    },
    "recurring_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Recurring Id",
      "type": "string"
    },
    "template_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Template Id",
      "type": "string"
    }
  },
  "required": [
    "recurring_id",
    "template_id",
    "entity_id",
    "frequency",
    "day",
    "first_period",
    "preparer",
    "description",
    "lines"
  ],
  "title": "RecurringJournal",
  "type": "object"
}
